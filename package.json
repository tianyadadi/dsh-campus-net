{
  "name": "dsh-campus-net",
  "version": "0.2.0",
  "description": "校园网（Srun 深澜）连接器：侧边栏小挂件，实时上下行速度、一键开关、开机自动连接、黑洞网卡检测。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "core",
    "救急重连.cmd"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "license": "MIT"
}